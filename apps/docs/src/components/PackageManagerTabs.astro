---
import { Code } from "@astrojs/starlight/components";

export interface Props {
  packageName: string;
  dev?: boolean;
}

const { packageName, dev = false } = Astro.props;

const managers = [
  {
    id: "npm",
    label: "npm",
    command: `npm install${dev ? " -D" : ""} ${packageName}`,
  },
  {
    id: "pnpm",
    label: "pnpm",
    command: `pnpm add${dev ? " -D" : ""} ${packageName}`,
  },
  {
    id: "yarn",
    label: "yarn",
    command: `yarn add${dev ? " -D" : ""} ${packageName}`,
  },
  {
    id: "bun",
    label: "bun",
    command: `bun add${dev ? " -d" : ""} ${packageName}`,
  },
];
---

<div class="pm-tabs" data-pm-tabs>
  <div class="pm-tabs__header">
    <div class="pm-tabs__list" role="tablist" aria-label="Package manager commands">
      {managers.map((manager, index) => (
        <button
          type="button"
          class="pm-tabs__tab"
          role="tab"
          id={`pm-tab-${manager.id}`}
          aria-controls={`pm-panel-${manager.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? "0" : "-1"}
          data-pm-tab={manager.id}
        >
          {manager.label}
        </button>
      ))}
    </div>
  </div>

  {managers.map((manager, index) => (
    <div
      class="pm-tabs__panel"
      role="tabpanel"
      id={`pm-panel-${manager.id}`}
      aria-labelledby={`pm-tab-${manager.id}`}
      hidden={index === 0 ? undefined : true}
      data-pm-panel={manager.id}
    >
      <Code code={manager.command} lang="sh" frame="none" />
    </div>
  ))}
</div>

<script>
  function initPackageManagerTabs(root: ParentNode): void {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-pm-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-pm-panel]"));

    function selectTab(id: string | undefined): void {
      if (!id) return;
      for (const tab of tabs) {
        const selected = tab.dataset.pmTab === id;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.setAttribute("tabindex", selected ? "0" : "-1");
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.pmPanel !== id;
      }
    }

    for (const tab of tabs) {
      tab.addEventListener("click", () => selectTab(tab.dataset.pmTab));
      tab.addEventListener("keydown", (event: KeyboardEvent) => {
        const currentIndex = tabs.indexOf(tab);
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const nextIndex = (currentIndex + direction + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        nextTab?.focus();
        selectTab(nextTab?.dataset.pmTab);
      });
    }
  }

  for (const root of document.querySelectorAll("[data-pm-tabs]")) {
    initPackageManagerTabs(root);
  }
</script>
