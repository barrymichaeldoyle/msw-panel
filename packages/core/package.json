{
  "name": "msw-panel",
  "version": "0.2.0",
  "description": "Devtools panel for Mock Service Worker — inspect and toggle handlers during development",
  "keywords": [
    "devtools",
    "mock service worker",
    "mocking",
    "msw",
    "testing"
  ],
  "homepage": "https://github.com/barrymichaeldoyle/msw-panel#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barrymichaeldoyle/msw-panel.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "react",
    "bridge"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react-lazy.d.ts"
      ],
      "bridge": [
        "./dist/bridge.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react-lazy.d.ts",
      "import": "./dist/react-lazy.js",
      "require": "./dist/react-lazy.cjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "require": "./dist/bridge.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/react-lazy.tsx src/bridge.ts --dts --format esm,cjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "msw": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
